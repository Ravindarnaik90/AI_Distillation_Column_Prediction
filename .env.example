# Copy this file to .env and fill in your own values.
# .env must NEVER be committed to git (see .gitignore) and is never sent to the browser —
# it is only read by backend/chat_service.py on the server.

# Groq Cloud API key (or any OpenAI-compatible provider). Leave blank to use
# the built-in rule-based DistilBot fallback instead of a live LLM.
GROQ_API_KEY=

# Only change these if you're using a different OpenAI-compatible provider.
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.3-70b-versatile
